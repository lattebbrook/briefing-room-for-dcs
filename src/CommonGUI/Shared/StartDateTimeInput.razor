@using System
@using System.Linq
@using BriefingRoom4DCS
@using BriefingRoom4DCS.Template
@inject BriefingRoom4DCS.IBriefingRoom briefingRoom

<div class="form-group start-date-time @ClassString">
    <label>@briefingRoom.Translate("StartDateTime")</label>
    <div class="generator-group flex-justify-spaced flex-margin-fix">
        <div class="form-group flex-block">
            <label>@briefingRoom.Translate("Date")</label>
            <select class="form-control" value="@Template.StartDateTimeDay" @onchange="OnDayChanged">
                <option value="@StartDateTimeSettings.DisabledDatePart">@briefingRoom.Translate("Disable")</option>
                @foreach (int day in Enumerable.Range(1, Template.GetStartDateTimeDaysInMonth()))
                {
                    <option value="@day">@day.ToString("00")</option>
                }
            </select>
        </div>
        <div class="form-group flex-block">
            <label>@briefingRoom.Translate("Month")</label>
            <select class="form-control" value="@Template.StartDateTimeMonth" @onchange="OnMonthChanged">
                <option value="@StartDateTimeSettings.DisabledDatePart">@briefingRoom.Translate("Disable")</option>
                @foreach (int month in Enumerable.Range(1, 12))
                {
                    <option value="@month">@((Month)(month - 1))</option>
                }
            </select>
        </div>
        <div class="form-group flex-block">
            <label>@briefingRoom.Translate("Year")</label>
            <select class="form-control" value="@Template.StartDateTimeYear" @onchange="OnYearChanged">
                <option value="@StartDateTimeSettings.DisabledDatePart">@briefingRoom.Translate("Disable")</option>
                @foreach (int year in Enumerable.Range(Template.GetStartDateTimeFirstYear(), 10))
                {
                    <option value="@year">@year</option>
                }
            </select>
        </div>
        <div class="form-group flex-block">
            <label>HH</label>
            <select class="form-control" value="@Template.StartDateTimeHour" @onchange="OnHourChanged">
                <option value="@StartDateTimeSettings.DisabledTimePart">@briefingRoom.Translate("Disable")</option>
                @foreach (int hour in Enumerable.Range(0, 24))
                {
                    <option value="@hour">@hour.ToString("00")</option>
                }
            </select>
        </div>
        <div class="form-group flex-block">
            <label>MM</label>
            <select class="form-control" value="@Template.StartDateTimeMinute" @onchange="OnMinuteChanged">
                <option value="@StartDateTimeSettings.DisabledTimePart">@briefingRoom.Translate("Disable")</option>
                @foreach (int minute in Enumerable.Range(0, 60))
                {
                    <option value="@minute">@minute.ToString("00")</option>
                }
            </select>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public BaseTemplate Template { get; set; }

    [Parameter]
    public string ClassString { get; set; } = "";

    protected override void OnParametersSet()
    {
        Template?.EnsureStartDateTimeIsValid();
    }

    private void OnDayChanged(ChangeEventArgs e) =>
        Template.StartDateTimeDay = ParseInt(e.Value, StartDateTimeSettings.DisabledDatePart);

    private void OnMonthChanged(ChangeEventArgs e) =>
        Template.StartDateTimeMonth = ParseInt(e.Value, StartDateTimeSettings.DisabledDatePart);

    private void OnYearChanged(ChangeEventArgs e) =>
        Template.StartDateTimeYear = ParseInt(e.Value, StartDateTimeSettings.DisabledDatePart);

    private void OnHourChanged(ChangeEventArgs e) =>
        Template.StartDateTimeHour = ParseInt(e.Value, StartDateTimeSettings.DisabledTimePart);

    private void OnMinuteChanged(ChangeEventArgs e) =>
        Template.StartDateTimeMinute = ParseInt(e.Value, StartDateTimeSettings.DisabledTimePart);

    private static int ParseInt(object value, int defaultValue)
    {
        return int.TryParse(Convert.ToString(value), out int parsed) ? parsed : defaultValue;
    }
}
